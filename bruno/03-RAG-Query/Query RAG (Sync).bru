meta {
  name: Query RAG (Sync)
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/api/v1/query
  body: json
  auth: none
}

body:json {
  {
    "query": "How does the event loop work in Python asyncio?",
    "top_k": 4,
    "stream": false
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.session_id) {
    bru.setEnvVar("sessionId", res.body.session_id);
  }
}

