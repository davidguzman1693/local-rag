meta {
  name: Create Session
  type: http
  seq: 2
}

post {
  url: {{gatewayUrl}}/api/v1/sessions
  body: json
  auth: none
}

body:json {
  {
    "title": "Asyncio Deep Dive"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("sessionId", res.body.id);
  }
}

